# Copy to .env for local development. Do not commit real .env files.
ERP_ENV=development
ERP_APP_NAME=Enterprise Commerce ERP
ERP_API_HOST=127.0.0.1
ERP_API_PORT=8000
ERP_API_PREFIX=/api/v1
ERP_API_BASE_URL=
ERP_API_INTERNAL_URL=http://127.0.0.1:8000
ERP_DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/enterprise_commerce_erp
ERP_LOCAL_SQLITE_URL=sqlite:///./runtime_data/local_cache.db
ERP_SECRET_KEY=dev-only-change-me
ERP_BOOTSTRAP_TOKEN=
ERP_SESSION_TTL_HOURS=12
ERP_ACCESS_TOKEN_TTL_MINUTES=30
ERP_REFRESH_TOKEN_TTL_HOURS=24
ERP_REMEMBER_ME_TTL_DAYS=30
ERP_ACTION_TOKEN_TTL_MINUTES=60
ERP_LOGIN_ATTEMPT_LIMIT=5
ERP_LOGIN_ATTEMPT_WINDOW_MINUTES=15
ERP_LOGIN_BLOCK_MINUTES=15
ERP_AUTH_RECORD_RETENTION_DAYS=90
ERP_AUTH_THROTTLE_RETENTION_DAYS=30
ERP_ALLOW_NEGATIVE_VENDOR_STOCK=false
ERP_BASE_CURRENCY=PKR
ERP_SMTP_HOST=
ERP_SMTP_PORT=587
ERP_SMTP_USERNAME=
ERP_SMTP_PASSWORD=
ERP_SMTP_FROM_EMAIL=
ERP_SMTP_USE_TLS=true
ERP_LOG_LEVEL=INFO
ERP_LOG_DIR=runtime_data/logs
ERP_LOG_MAX_BYTES=5242880
ERP_LOG_BACKUP_COUNT=5
ERP_LICENSE_SERVER_URL=
ERP_LICENSE_SERVER_ADMIN_KEY=dev-license-admin-key
ERP_LICENSE_OFFLINE_SIGNING_KEY=dev-offline-license-signing-key
ERP_LICENSE_DEVICE_ID=dev-device
ERP_LICENSE_OFFLINE_FILE=runtime_data/license/offline_license.json
ERP_SUPPORT_DIAGNOSTICS_DIR=runtime_data/diagnostics
ERP_MEDIA_UPLOAD_DIR=runtime_data/uploads
ERP_POSTGRES_BACKUP_DIR=runtime_data/backups
ERP_WORKER_HEARTBEAT_FILE=runtime_data/worker_heartbeat.json
ERP_DOCS_ENABLED=true
ERP_TRUSTED_HOSTS=["*"]
ERP_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
ERP_CORS_ORIGINS=[]
ERP_FORCE_HTTPS=false
ERP_WHATSAPP_ENABLED=true
ERP_PUSH_ENABLED=false
ERP_PUSH_VAPID_PUBLIC_KEY=
ERP_PUSH_VAPID_PRIVATE_KEY=
ERP_PUSH_VAPID_SUBJECT=mailto:admin@example.com
ERP_PUSH_TTL_SECONDS=300
ERP_PUSH_MAX_ATTEMPTS=5
ERP_PUSH_POLL_SECONDS=5
ERP_WORKER_LOOP=false
ERP_WORKER_POLL_SECONDS=300
ERP_MAX_REQUEST_SIZE_MB=10
