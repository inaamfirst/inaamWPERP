{
  "api_routes": [
    "/api/v1/auth/login",
    "/api/v1/auth/refresh",
    "/api/v1/auth/me",
    "/api/v1/auth/logout",
    "/api/v1/auth/change-password",
    "/api/v1/auth/password-reset/request",
    "/api/v1/auth/password-reset/confirm",
    "/api/v1/auth/activate",
    "/api/v1/auth/register/vendor",
    "/api/v1/identity/permissions",
    "/api/v1/identity/roles",
    "/api/v1/identity/roles/{role_id}",
    "/api/v1/identity/users",
    "/api/v1/identity/users/{user_id}",
    "/api/v1/identity/users/{user_id}/reset-password"
  ],
  "dependencies": [
    "core"
  ],
  "description": "User authentication, users, roles, and permission assignments.",
  "desktop_pages": [
    "admin"
  ],
  "enabled_by_default": true,
  "events": [
    "identity.user_created",
    "identity.user_login",
    "identity.user_updated",
    "identity.user_password_reset",
    "auth.refresh_rotated",
    "auth.refresh_reuse_detected",
    "auth.password_changed",
    "auth.activation_completed",
    "identity.role_created",
    "identity.role_updated"
  ],
  "id": "identity",
  "migrations": [
    "202607010014_auth_ledger_vendor_inventory"
  ],
  "name": "Identity and Users",
  "permissions": [
    "identity.view_users",
    "identity.manage_users",
    "identity.manage_roles",
    "identity.manage_sessions"
  ],
  "status": "implemented",
  "version": "0.1.0"
}
