# Copy this file to C:\ProgramData\ChoiceOye\Enterprise Commerce ERP\production.env.
# The scheduled API and worker tasks run as LocalSystem; allow only SYSTEM and
# the designated deployment administrator to read the real file. Do not commit it.
ERP_ENV=production
ERP_APP_NAME=Enterprise Commerce ERP
ERP_API_HOST=127.0.0.1
ERP_API_PORT=8000
ERP_API_PREFIX=/api/v1
ERP_API_BASE_URL=https://erp.example.com
ERP_API_INTERNAL_URL=http://127.0.0.1:8000
ERP_DATABASE_URL=postgresql+psycopg://erp_app_user:CHANGE_ME@127.0.0.1:5432/enterprise_commerce_erp
ERP_LOCAL_SQLITE_URL=sqlite:///./runtime_data/local_cache.db
ERP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ERP_BOOTSTRAP_TOKEN=CHANGE_ME_TO_A_SEPARATE_32_CHARACTER_RANDOM_TOKEN
ERP_SESSION_TTL_HOURS=12
ERP_LOG_LEVEL=INFO
ERP_LOG_DIR=C:/ProgramData/ChoiceOye/Enterprise Commerce ERP/runtime_data/logs
ERP_LOG_MAX_BYTES=5242880
ERP_LOG_BACKUP_COUNT=5
ERP_LICENSE_SERVER_URL=https://licenses.example.com
ERP_LICENSE_SERVER_ADMIN_KEY=CHANGE_ME_TO_LICENSE_ADMIN_KEY
ERP_LICENSE_OFFLINE_SIGNING_KEY=CHANGE_ME_TO_OFFLINE_LICENSE_SIGNING_KEY
ERP_LICENSE_DEVICE_ID=CHANGE_ME_TO_INSTALLATION_DEVICE_ID
ERP_LICENSE_OFFLINE_FILE=C:/ProgramData/ChoiceOye/Enterprise Commerce ERP/runtime_data/license/offline_license.json
ERP_SUPPORT_DIAGNOSTICS_DIR=C:/ProgramData/ChoiceOye/Enterprise Commerce ERP/runtime_data/diagnostics
ERP_MEDIA_UPLOAD_DIR=C:/ProgramData/ChoiceOye/Enterprise Commerce ERP/runtime_data/uploads
ERP_POSTGRES_BACKUP_DIR=C:/ProgramData/ChoiceOye/Enterprise Commerce ERP/backups
ERP_WORKER_HEARTBEAT_FILE=C:/ProgramData/ChoiceOye/Enterprise Commerce ERP/runtime_data/worker_heartbeat.json
ERP_DOCS_ENABLED=false
ERP_TRUSTED_HOSTS=["erp.example.com"]
ERP_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
ERP_CORS_ORIGINS=[]
ERP_FORCE_HTTPS=true
ERP_WHATSAPP_ENABLED=false
ERP_PUSH_ENABLED=true
ERP_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
ERP_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
ERP_PUSH_VAPID_SUBJECT=mailto:admin@example.com
ERP_PUSH_TTL_SECONDS=300
ERP_PUSH_MAX_ATTEMPTS=5
ERP_PUSH_POLL_SECONDS=5
ERP_WORKER_LOOP=true
ERP_WORKER_POLL_SECONDS=10
ERP_MAX_REQUEST_SIZE_MB=10
